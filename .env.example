# Copie ce fichier en ".env" et remplis les 2 valeurs.
# Ne partage JAMAIS le .env (il contient ton token secret).

# Le token donne par @BotFather (ex: 8123456789:AAH...xyz)
TELEGRAM_TOKEN=colle_ton_token_ici

# Ton chat_id donne par @userinfobot (un nombre, ex: 123456789)
TELEGRAM_CHAT_ID=colle_ton_chat_id_ici
